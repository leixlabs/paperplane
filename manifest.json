{
  "manifest_version": 3,
  "name": "Paperplane · 一键 AI 摘要推 TG",
  "version": "1.2.0",
  "description": "点击一下图标，用浏览器本地 AI（Gemini Nano）把当前网页提炼成要点，直发 Telegram 频道。零后端、零 API Key。",
  "minimum_chrome_version": "127",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen",
    "notifications"
  ],

  "host_permissions": [
    "https://api.telegram.org/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_title": "Paperplane · 发送到 Telegram（AI 摘要）",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "commands": {
    "send-to-telegram": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "Paperplane：把当前网页的 AI 摘要发送到 Telegram"
    }
  }
}
